# ---------------------------------------------------------------
# Line ending / encoding policy
#
# All CAPL sources are kept as pure ASCII, so no working-tree-encoding
# conversion is needed. This removes every code page related problem
# between CANoe, Git, VS Code and GitHub.
# ---------------------------------------------------------------

# Do not let Git guess
* -text

# CAPL sources - ASCII, CRLF (CANoe is Windows only)
*.can  text eol=crlf
*.cin  text eol=crlf

# Network databases - text, diffable
*.dbc   text eol=crlf
*.ldf   text eol=crlf
*.arxml text eol=crlf
*.xml   text eol=crlf

# Binary - Git must not touch the content
*.cfg      binary
*.stcfg    binary
*.vsysvar  binary
*.cdd      binary
*.odx      binary
*.pdx      binary
*.tse      binary
*.xvp      binary
*.xlsx     binary
*.pdf      binary
*.vtcfg.local binary

# Documentation
*.md text eol=lf