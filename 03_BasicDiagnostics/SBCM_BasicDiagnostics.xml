<!--
  SBCM_BasicDiagnostics.xml
  Project: UDS Study

  CANoe "Basic Diagnostics" ECU description for the SBCM simulator.
  This file must be kept in sync with the actually implemented CAPL
  services (04_CAPL/UDS_Service_10.cin, UDS_Service_11.cin,
  UDS_Service_14.cin, UDS_Service_19.cin, UDS_Service_22.cin,
  UDS_Service_27.cin, UDS_Service_28.cin, UDS_Service_2E.cin,
  UDS_Service_2F.cin, UDS_Service_31.cin, UDS_Service_34_35_36_37.cin,
  UDS_Service_3E.cin, UDS_Service_85.cin, UDS_DTC_Store.cin): whenever a
  service is added or its request/response format changes, this file must
  be updated to match, in the same commit as the CAPL change.

  Schema note: this file's structure (ECU/NEGATIVE_RESPONSE_CODES/INSTANCE/
  REQUEST/RESPONSE/PARAMETER elements and attributes, and the "bitPos =
  startByte*8 + 7" convention used for every PARAMETER regardless of its
  own bitLen) was reverse-engineered from a real, working CANoe Basic
  Diagnostics export (PDIO_FL ECU) supplied by the user on 2026-08-18, to
  avoid Commit/compile errors when this file is loaded.

  Revision History
  Date          Author                      Description
  2026-08-18    lee.sungwon@slworld.com    Initial version - DiagnosticSessionControl
                                            (Default/Programming/Extended session,
                                            2-byte response - no sessionParameterRecord,
                                            matching the actual CAPL response),
                                            TesterPresent (zeroSubFunction only),
                                            ReadDataByIdentifier (F100/F1B1/F197,
                                            matching UDS_Service_22.cin's fixed
                                            sample data exactly)
  2026-08-18    lee.sungwon@slworld.com    Populated NEGATIVE_RESPONSE_CODES using the
                                            confirmed working <MAP nrc="decimal"
                                            text="..."/> syntax (nrc = decimal, NOT hex),
                                            verified by the user against a real, working
                                            CANoe-generated file (user tested via the
                                            Basic Diagnostics Editor UI). All 40 entries
                                            are copied verbatim from that confirmed file,
                                            including its wording quirks (e.g. "Vehicle
                                            speed to low", "Shifter level not in park").
  2026-08-18    lee.sungwon@slworld.com    REVERTED: removed 19 additional NRCs (0x34,
                                            0x38-0x3A, 0x50-0x5D, 0x94 - the newer
                                            ISO 14229-1:2020 auth/certificate/secure-
                                            data-transmission codes) that were added on
                                            top of the user's confirmed 40 in an earlier
                                            revision. CANoe crashed after that change;
                                            those 19 entries were never verified against
                                            a real working file (unlike the base 40), so
                                            this reverts to EXACTLY the user-confirmed
                                            40-entry set to isolate the crash cause.
  2026-08-18    lee.sungwon@slworld.com    Every MAP's text now shows the NRC code
                                            itself, not just the English description:
                                            "0x22(Conditions not correct)" instead of
                                            just "Conditions not correct", so the
                                            Diagnostics Console's negative-response log
                                            makes the exact byte value visible at a
                                            glance without cross-referencing a table.
  2026-08-18    lee.sungwon@slworld.com    Added SecurityAccessRequestSeed
                                            (0x27/0x11) and
                                            SecurityAccessSendKey (0x27/0x12)
                                            INSTANCEs - ASK variant only, per
                                            ES95486-02 4.3 and
                                            04_CAPL/UDS_Service_27.cin. Seed/
                                            Key are both 8 bytes; the example
                                            "value" shown for securitySeed/
                                            securityKey (all-zero) is a
                                            placeholder only - the ECU
                                            generates a real random Seed at
                                            runtime (all-zero only applies
                                            when already unlocked), and the
                                            matching Key must be computed via
                                            the tester-side Seed and Key DLL
                                            (03_BasicDiagnostics/
                                            SecurityAccessDLL/
                                            GenerateKeyExOpt.cpp), not typed
                                            in manually.
  2026-08-19    lee.sungwon@slworld.com    Added 20 new INSTANCEs covering
                                            all 11 services implemented as
                                            part of the ES95486-02 10.2
                                            reprogramming-sequence work
                                            (Stages 1-3): ECUResetHardReset
                                            (0x11), ClearDiagnosticInformationAll
                                            (0x14), ReadDTCInfoReportNumberByStatusMask/
                                            ReadDTCInfoReportDTCByStatusMask/
                                            ReadDTCInfoReportSupportedDTC (0x19,
                                            3 sub-functions),
                                            CommunicationControlDisableRxAndTx/
                                            CommunicationControlEnableRxAndTx (0x28),
                                            WriteDataByIdentifierRepairShopCode (0x2E,
                                            new writable DID F198),
                                            IOControlSampleOutputReturnControlToECU/
                                            IOControlSampleOutputResetToDefault/
                                            IOControlSampleOutputShortTermAdjustment
                                            (0x2F, invented sample DID F010),
                                            RoutineControlEraseMemory/
                                            RoutineControlCheckProgrammingDependencies
                                            (0x31), RequestDownloadApplicationSoftware
                                            (0x34), RequestUploadApplicationSoftware
                                            (0x35), TransferDataDownloadBlock/
                                            TransferDataUploadBlock (0x36),
                                            RequestTransferExit (0x37),
                                            ControlDTCSettingOn/
                                            ControlDTCSettingOff (0x85). All
                                            byte layouts were re-derived
                                            directly from the actual CAPL
                                            source in 04_CAPL (not from
                                            memory/notes) immediately before
                                            writing this XML, and cross-
                                            checked against ES95486-02's own
                                            worked examples where one exists
                                            (Table 10-11 for RoutineControl,
                                            Table 10-12 for RequestDownload/
                                            RequestUpload). No NEGATIVE_RESPONSE_CODES
                                            changes were needed - every NRC
                                            used by the new services (0x10/
                                            0x12/0x13/0x22/0x24/0x31/0x33/
                                            0x70/0x71/0x72/0x73/0x7F) was
                                            already present in the existing
                                            40-entry table. IMPORTANT caveats
                                            documented per-INSTANCE below:
                                            (1) ReadDTCInfo's DTCCount/
                                            DTCNumber/statusOfDTC example
                                            values are illustrative only -
                                            actual values depend on the
                                            sample DTC's live status (see
                                            UDS_DTC_Store.cin); (2)
                                            TransferDataDownloadBlock/
                                            TransferDataUploadBlock cannot
                                            be sent standalone - they require
                                            a prior successful RequestDownload/
                                            RequestUpload in the same
                                            measurement (same caveat already
                                            applied to SecurityAccessSendKey);
                                            (3) CommunicationControl's two
                                            INSTANCEs use controlType WITHOUT
                                            the suppressPositiveResponse bit
                                            (0x03/0x00, not ES95486-02 Table
                                            10-7's wire values 0x83/0x80) so
                                            the Diagnostics Console actually
                                            receives a response to inspect -
                                            the suppressed-response wire
                                            values are the ones a real
                                            reprogramming sequence uses, but
                                            they are not useful as a Console
                                            example.
  2026-08-19    lee.sungwon@slworld.com    Updated 5 INSTANCEs to match CAPL
                                            changes made after cross-checking
                                            against a real-world production
                                            diagnostic spec (NE1aW_SBCM_
                                            Diagnostic_Data_251104.xlsx):
                                            (1) ECUSoftwareUNIT1Version (0x22
                                            F1B1) - data now 6 bytes "26.610"
                                            (was 5-byte "26610"); (2)
                                            WriteDataByIdentifierRepairShopCode
                                            replaced with
                                            WriteDataByIdentifierEOLVariantCoding
                                            (0x2E, DID 0xC0DE "EOL Variant
                                            Coding", 8-byte HEX, Extended
                                            session only - was DID 0xF198,
                                            10-byte ASCII), plus a new
                                            ReadDataByIdentifierEOLVariantCoding
                                            (0x22, same DID) INSTANCE for the
                                            read-back path; (3)
                                            ReadDTCInfoReportDTCByStatusMask/
                                            ReadDTCInfoReportSupportedDTC
                                            (0x19) - DTCNumber now 96 03 00
                                            ("B160300", a real DTC) instead of
                                            the invented B1 01 00; (4)
                                            RoutineControlEraseMemory (0x31,
                                            RID FF00) - added the real
                                            SWUnitMemoryArea request parameter
                                            and SWUnitMemoryArea/
                                            ErasedPartitionArea response
                                            parameters; (5)
                                            RequestDownloadApplicationSoftware/
                                            RequestUploadApplicationSoftware
                                            (0x34/0x35) - added a comment
                                            documenting that memoryAddress
                                            0x001B67 is now the only value
                                            accepted (NRC 0x70 otherwise);
                                            the example value itself was
                                            already 00 1B 67, unchanged. See
                                            04_CAPL/UDS_Service_22.cin,
                                            UDS_Service_2E.cin,
                                            UDS_DTC_Store.cin,
                                            UDS_Service_31.cin and
                                            UDS_Service_34_35_36_37.cin for
                                            the corresponding CAPL changes
                                            (all dated 2026-08-19). No
                                            NEGATIVE_RESPONSE_CODES changes
                                            were needed - NRC 0x70 was
                                            already present in the existing
                                            table.
-->
<ECU protocol="UDS">
 <NEGATIVE_RESPONSE_CODES>
  <MAP nrc="16" text="0x10(General reject)"/>
  <MAP nrc="17" text="0x11(Service not supported)"/>
  <MAP nrc="18" text="0x12(Sub-function not supported)"/>
  <MAP nrc="19" text="0x13(Incorrect Message Length or Invalid Format)"/>
  <MAP nrc="20" text="0x14(Response too long)"/>
  <MAP nrc="33" text="0x21(Busy - repeat request)"/>
  <MAP nrc="34" text="0x22(Conditions not correct)"/>
  <MAP nrc="36" text="0x24(Request Sequence Error)"/>
  <MAP nrc="37" text="0x25(No response from subnet component)"/>
  <MAP nrc="38" text="0x26(Failure prevents execution of requested action)"/>
  <MAP nrc="49" text="0x31(Request out of range)"/>
  <MAP nrc="51" text="0x33(Security access denied)"/>
  <MAP nrc="53" text="0x35(Invalid key)"/>
  <MAP nrc="54" text="0x36(Exceed number of attempts)"/>
  <MAP nrc="55" text="0x37(Required time delay not expired)"/>
  <MAP nrc="112" text="0x70(Upload Download not accepted)"/>
  <MAP nrc="113" text="0x71(Transfer suspended)"/>
  <MAP nrc="114" text="0x72(General Programming Failure)"/>
  <MAP nrc="115" text="0x73(Wrong Block Sequence Counter)"/>
  <MAP nrc="120" text="0x78(Request correctly received - response pending)"/>
  <MAP nrc="126" text="0x7E(Sub-function not supported in active session)"/>
  <MAP nrc="127" text="0x7F(Service not supported in active session)"/>
  <MAP nrc="129" text="0x81(RPM too high)"/>
  <MAP nrc="130" text="0x82(RPM too low)"/>
  <MAP nrc="131" text="0x83(Engine is running)"/>
  <MAP nrc="132" text="0x84(Engine is not running)"/>
  <MAP nrc="133" text="0x85(Engine Run time too low)"/>
  <MAP nrc="134" text="0x86(Temperature too high)"/>
  <MAP nrc="135" text="0x87(Temperature too low)"/>
  <MAP nrc="136" text="0x88(Vehicle speed too high)"/>
  <MAP nrc="137" text="0x89(Vehicle speed to low)"/>
  <MAP nrc="138" text="0x8A(Throttle/Pedal too high)"/>
  <MAP nrc="139" text="0x8B(Throttle/Pedal too low)"/>
  <MAP nrc="140" text="0x8C(Transmission range not in neutral)"/>
  <MAP nrc="141" text="0x8D(Transmission range not in gear)"/>
  <MAP nrc="143" text="0x8F(Brake Switch(es) not closed)"/>
  <MAP nrc="144" text="0x90(Shifter level not in park)"/>
  <MAP nrc="145" text="0x91(Torque converter clutch locked)"/>
  <MAP nrc="146" text="0x92(Voltage too high)"/>
  <MAP nrc="147" text="0x93(Voltage too low)"/>
 </NEGATIVE_RESPONSE_CODES>
