includes
{
    #include "UDS_Common.cin"
    #include "NetworkLayer_API.cin"
    #include "VehicleCondition.cin"
    #include "UDS_DTC_Store.cin"
    #include "UDS_Service_10.cin"
    #include "UDS_Service_3E.cin"
    #include "UDS_Service_11.cin"
    #include "UDS_Service_14.cin"
    #include "UDS_Service_19.cin"
    #include "UDS_Service_22.cin"
    #include "UDS_Service_27.cin"
    #include "UDS_Service_28.cin"
    #include "UDS_Service_2E.cin"
    #include "UDS_Service_2F.cin"
    #include "UDS_Service_85.cin"
}

variables
{
}

on preStart
{
    NetworkLayer_Init();
    VehicleCondition_Init();
    UDS_SessionInit();
    write("SBCM ECU Simulator: UDS services initialized. Waiting for requests on 0x7B0 ...");
}

// ===========================================================================
// Called by UDS_Service_11.cin's Handle_ECUReset() (hardReset), AFTER the
// positive response has already been sent (ES95486-02 4.2). Reinitializes
// exactly the state a real ECU power-cycle would touch, and deliberately
// leaves untouched what a real reset would NOT clear:
//   - Diagnostic session -> Default (UDS_SetCurrentSession)
//   - SecurityAccess unlock state -> re-locked, but the 3-attempt counter/
//     180s lockout timer are NOT cleared (SecurityAccess_ResetOnSessionChange()
//     already encodes this - see UDS_Service_27.cin's revision history for
//     the security rationale)
//   - CommunicationControl -> re-enabled (ES95486-02 10.2.2.10 wires an
//     explicit CommunicationControl(enableRxAndTx) within 15ms of the reset
//     response anyway, but this also matches 4.1's "return to Default"
//     reset rule directly)
//   - ControlDTCSetting -> DTC storage re-enabled (ES95486-02 4.7: "if
//     ECUReset service is successfully performed, DTC storage resumes")
//   - NOT reinitialized: stored DTC content (UDS_DTC_Store.cin's dtcStatus[]
//     persists across a reset in a real ECU - only ClearDiagnosticInformation
//     (0x14) clears it)
// ===========================================================================
void UDS_PerformHardReset()
{
    write("SBCM ECU Simulator: ECUReset(hardReset) - reinitializing to Default Session");
    UDS_SetCurrentSession(SUBFUNC_DEFAULT_SESSION);
    SecurityAccess_ResetOnSessionChange();
    CommunicationControl_ReEnableOnDefaultSession();
    DTC_Store_ReEnableStorageOnDefaultSession();
}

// ===========================================================================
// Application Layer callback
// Called by NetworkLayer_API.cin once a complete UDS request is available.
// ===========================================================================
void AppLayer_OnDiagRequestReceived(byte data[], word len)
{
    byte sid;

    sid = data[0];

    write("AppLayer: UDS request received (len=%d, SID=0x%02X)", len, sid);

    switch (sid)
    {
        case 0x10:
            UDS_Handle_DiagnosticSessionControl(data, len);
            break;

        case 0x11:
            UDS_Handle_ECUReset(data, len);
            break;

        case 0x14:
            UDS_Handle_ClearDiagnosticInformation(data, len);
            break;

        case 0x19:
            UDS_Handle_ReadDTCInformation(data, len);
            break;

        case 0x22:
            UDS_Handle_ReadDataByIdentifier(data, len);
            break;

        case 0x27:
            UDS_Handle_SecurityAccess(data, len);
            break;

        case 0x28:
            UDS_Handle_CommunicationControl(data, len);
            break;

        case 0x2E:
            UDS_Handle_WriteDataByIdentifier(data, len);
            break;

        case 0x2F:
            UDS_Handle_InputOutputControlByIdentifier(data, len);
            break;

        case 0x3E:
            UDS_Handle_TesterPresent(data, len);
            break;

        case 0x85:
            UDS_Handle_ControlDTCSetting(data, len);
            break;

        default:
            AppLayer_SendNegativeResponse(sid, NRC_SERVICE_NOT_SUPPORTED);
            break;
    }
}

void UDS_SessionInit()
{
    DTC_Store_Init();
    UDS_Service_10_Init();
    UDS_Service_3E_Init();
    UDS_Service_22_Init();
    UDS_Service_27_Init();
    CommunicationControl_Init();
    UDS_Service_2E_Init();
    UDS_Service_2F_Init();
}

void UDS_Handle_DiagnosticSessionControl(byte data[], word len)
{
    Handle_DiagnosticSessionControl(data, len);
}

void UDS_Handle_TesterPresent(byte data[], word len)
{
    Handle_TesterPresent(data, len);
}

void UDS_Handle_ReadDataByIdentifier(byte data[], word len)
{
    Handle_ReadDataByIdentifier(data, len);
}

