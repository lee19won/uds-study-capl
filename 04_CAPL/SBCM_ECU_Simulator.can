{
    Handle_SecurityAccess(data, len);
}

void UDS_Handle_ECUReset(byte data[], word len)
{
    Handle_ECUReset(data, len);
}

void UDS_Handle_ClearDiagnosticInformation(byte data[], word len)
{
    Handle_ClearDiagnosticInformation(data, len);
}

void UDS_Handle_ReadDTCInformation(byte data[], word len)
{
    Handle_ReadDTCInformation(data, len);
}

void UDS_Handle_CommunicationControl(byte data[], word len)
{
    Handle_CommunicationControl(data, len);
}

void UDS_Handle_ControlDTCSetting(byte data[], word len)
{
    Handle_ControlDTCSetting(data, len);
